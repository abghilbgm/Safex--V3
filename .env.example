# Copy this file to .env before running: cp .env.example .env
#
# NOTE ON POSTGRES_HOST:
#   - If running via `docker compose up` -> docker-compose.yml already
#     overrides POSTGRES_HOST to "postgres" automatically. You do NOT need
#     to change it here for Docker.
#   - If running LOCALLY (python -m app.main, no Docker) against a Postgres
#     you installed yourself -> set POSTGRES_HOST=localhost below.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ppe_compliance
POSTGRES_USER=ppe_user
POSTGRES_PASSWORD=ppe_password
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10
# How long the app will keep retrying the initial DB connection before
# giving up with a clear error (instead of crashing instantly on the first
# try, which is what caused "Application startup failed. Exiting." before).
POSTGRES_CONNECT_RETRY_SECONDS=60

PPE_MODEL_PATH=models/best.pt
PPE_DEVICE=cpu
PPE_CONF_THRESHOLD=0.45
PPE_IOU_THRESHOLD=0.45
PPE_IMG_SIZE=640
PPE_FRAME_SKIP=2
PPE_VIOLATION_CONFIRM_FRAMES=5

PPE_ALERTS_ENABLED=true
PPE_TEAMS_WEBHOOK=

PPE_SMTP_HOST=
PPE_SMTP_PORT=587
PPE_SMTP_USER=
PPE_SMTP_PASSWORD=
PPE_ALERT_EMAIL_FROM=
PPE_ALERT_EMAIL_TO=

PPE_SNAPSHOT_DIR=snapshots
PPE_API_HOST=0.0.0.0
PPE_API_PORT=8080
PPE_JPEG_QUALITY=82
PPE_BROADCAST_FPS=12
