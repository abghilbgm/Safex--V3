# Copy this file to .env and fill in real values before running.
# NOTE: Your 16 camera RTSP URLs are already hardcoded directly in
# app/config.py (SEED_CAMERAS) since each uses a different IP/channel/
# password. You do NOT need to set them here. If you need to change a
# camera's RTSP URL later, do it from the dashboard's Cameras tab (Edit)
# instead of editing this file or config.py - see README.md Step 7.

# --- Model ---
PPE_MODEL_PATH=models/best.pt
PPE_DEVICE=cpu
PPE_CONF_THRESHOLD=0.45
PPE_IOU_THRESHOLD=0.45
PPE_IMG_SIZE=640
PPE_FRAME_SKIP=2
PPE_VIOLATION_CONFIRM_FRAMES=5

# --- Alert channel credentials (WHO/HOW - the WHEN lives in the alert_rules
#     DB table, managed from the dashboard's Rules tab) ---
PPE_ALERTS_ENABLED=true
PPE_TEAMS_WEBHOOK=

PPE_SMTP_HOST=
PPE_SMTP_PORT=587
PPE_SMTP_USER=
PPE_SMTP_PASSWORD=
PPE_ALERT_EMAIL_FROM=
PPE_ALERT_EMAIL_TO=

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ppe_compliance
POSTGRES_USER=ppe_user
POSTGRES_PASSWORD=ppe_password
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# --- Storage ---
PPE_SNAPSHOT_DIR=snapshots

# --- API ---
PPE_API_HOST=0.0.0.0
PPE_API_PORT=8080
PPE_JPEG_QUALITY=82
PPE_BROADCAST_FPS=12
