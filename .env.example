# Copy to .env: cp .env.example .env
# docker-compose.yml automatically overrides POSTGRES_HOST to "postgres"
# for the app container - you do NOT need to change it here for Docker.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ppe_compliance
POSTGRES_USER=ppe_user
POSTGRES_PASSWORD=ppe_password
# Raised from earlier default of 10 -> 30. With 16 cameras each
# occasionally needing a DB connection, a small pool gets exhausted under
# load causing cameras to drop and API calls (like /api/violations) to
# fail. 30 comfortably supports 16+ concurrent camera workers.
POSTGRES_POOL_MIN=4
POSTGRES_POOL_MAX=30
POSTGRES_CONNECT_RETRY_SECONDS=60

PPE_MODEL_PATH=models/best.pt
PPE_DEVICE=cpu
PPE_CONF_THRESHOLD=0.45
PPE_IOU_THRESHOLD=0.45
PPE_IMG_SIZE=640
PPE_FRAME_SKIP=2
PPE_VIOLATION_CONFIRM_FRAMES=5
# How often (seconds) each camera writes its connectivity status to the
# DB. Previously this ran on every loop tick (~100x/sec/camera) which
# exhausted the DB pool with many cameras - now throttled.
PPE_STATUS_UPDATE_INTERVAL=4

PPE_ALERTS_ENABLED=true
PPE_TEAMS_WEBHOOK=

PPE_SMTP_HOST=
PPE_SMTP_PORT=587
PPE_SMTP_USER=
PPE_SMTP_PASSWORD=
PPE_ALERT_EMAIL_FROM=
PPE_ALERT_EMAIL_TO=

PPE_SNAPSHOT_DIR=snapshots
PPE_API_HOST=0.0.0.0
PPE_API_PORT=8080
PPE_JPEG_QUALITY=82
PPE_BROADCAST_FPS=12
